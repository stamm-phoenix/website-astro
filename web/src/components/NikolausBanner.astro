---
import type { NikolausConfig } from '../lib/nikolausConfig';
import { formatNikolausDays } from '../lib/nikolausConfig';

interface Props {
  config: NikolausConfig;
}

const { config } = Astro.props;
const dayNames = formatNikolausDays(config);
---

<section
  class="mb-6 rounded-[var(--radius-lg)] bg-danger p-5 md:p-6 text-white"
  aria-labelledby="nikolaus-banner-heading"
>
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 id="nikolaus-banner-heading" class="font-serif text-xl md:text-2xl font-bold">
        Jetzt Termin mit dem Nikolaus ausmachen!
      </h2>
      <p class="mt-1 text-sm text-white/90">
        Nikolausdienst am {dayNames}: Nikolaus, Krampus und Engerl besuchen Sie zu Hause, solange
        Termine frei sind.
      </p>
    </div>
    <a
      href="/nikolaus"
      class="ui-btn ui-btn--primary inline-flex min-h-11 shrink-0 items-center justify-center self-start rounded-md bg-surface px-5 py-2.5 text-sm font-semibold text-danger no-underline transition hover:bg-[var(--color-dpsg-beige-1)] active:bg-[var(--color-dpsg-beige-2)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white md:self-center"
    >
      Termin buchen
    </a>
  </div>
</section>
