---
interface Props {
  variant?: 'default' | 'muted';
  accent?: boolean;
  hover?: boolean;
  class?: string;
}

const { variant = 'default', accent = false, hover = false, class: className = '' } = Astro.props;

const baseClasses = variant === 'muted' ? 'ui-card surface-muted' : 'ui-card surface';

const classes = [
  baseClasses,
  'p-5',
  accent && 'border-l-4 border-l-[var(--color-accent-500)]',
  hover && 'transition-colors duration-150 hover:border-brand-300',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<article class={classes}>
  <slot />
</article>
