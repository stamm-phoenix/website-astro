---
import Button from './Button.astro';
import MobileMenu from './MobileMenu.svelte';
import { NIKOLAUS_CONFIG } from '../lib/nikolausConfig';

const nav = [
  { href: '/', label: 'Start' },
  // Only shown while the Nikolausdienst booking is active
  ...(NIKOLAUS_CONFIG.publicActive ? [{ href: '/nikolaus', label: 'Nikolaus' }] : []),
  { href: '/gruppenstunden', label: 'Gruppenstunden' },
  { href: '/aktionen', label: 'Aktionen' },
  { href: '/blog', label: 'Blog' },
  { href: '/downloads', label: 'Downloads' },
  { href: '/fragen-und-antworten', label: 'FAQ' },
  { href: '/vorstand', label: 'Vorstand' },
  { href: '/kontakt', label: 'Kontakt' },
];

const mobileNav = [...nav, { href: '/mitmachen', label: 'Mitmachen' }];

const staffLink = { href: '/leitendenbereich', label: 'Leitendenbereich' };

const currentPath = Astro.url?.pathname ?? '/';
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header id="site-nav" class="ui-header nav-shell relative w-full px-0">
  <div class="nav-inner relative flex w-full items-center gap-4 px-3 py-2 md:px-5 md:py-3">
    <a
      href="/"
      class="relative z-10 flex items-center gap-3 no-underline hover:no-underline"
      aria-label="Stamm Phoenix – DPSG Feldkirchen-Westerham"
    >
      <img
        src="/stammeslilie.svg"
        alt=""
        width="380"
        height="490"
        class="h-14 w-auto shrink-0 select-none md:h-16"
        loading="eager"
        decoding="async"
      />
      <span class="leading-tight">
        <span class="ui-wordmark block font-serif text-xl font-bold text-brand-900 md:text-2xl">
          Stamm Phoenix
        </span>
        <span class="mt-0.5 block text-sm text-neutral-700">DPSG Feldkirchen-Westerham</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden 2xl:block relative z-10" aria-label="Hauptnavigation">
      <ul class="flex items-center gap-1 md:gap-2">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link inline-flex items-center px-3 py-2 text-sm font-semibold no-underline text-brand-900 decoration-2 underline-offset-8 hover:underline active:text-[var(--color-dpsg-red)] aria-[current=page]:underline aria-[current=page]:decoration-[var(--color-dpsg-red)]"
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2 md:gap-4">
      <a
        href={staffLink.href}
        class="nav-link hidden 2xl:inline-flex items-center gap-2 px-3 py-2 text-sm font-semibold no-underline text-brand-900 decoration-2 underline-offset-8 hover:underline active:text-[var(--color-dpsg-red)] aria-[current=page]:underline aria-[current=page]:decoration-[var(--color-dpsg-red)]"
        aria-current={isCurrent(staffLink.href) ? 'page' : undefined}
      >
        <svg
          aria-hidden="true"
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="4" y="11" width="16" height="10" rx="2"></rect>
          <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
        </svg>
        {staffLink.label}
      </a>
      <div class="hidden 2xl:block">
        <Button href="/mitmachen" variant="cta">
          {' '}
          Mitmachen{' '}
        </Button>
      </div>
      <img
        src="/dpsg_ohne.png"
        alt="DPSG"
        width="228"
        height="90"
        class="hidden h-9 w-auto object-contain sm:block md:h-10"
        loading="eager"
        decoding="async"
      />
      <!-- Mobile and tablet: menu button (Svelte island), its panel opens on the right -->
      <MobileMenu
        nav={mobileNav}
        staffLink={staffLink}
        currentPath={currentPath}
        client:only="svelte"
      />
    </div>
  </div>
</header>

<style>
  .nav-shell {
    transition:
      padding 0.24s ease,
      transform 0.24s ease;
  }
  .nav-shell .nav-inner {
    transition:
      max-width 0.24s ease,
      border-radius 0.24s ease,
      box-shadow 0.24s ease,
      border-color 0.24s ease;
    max-width: none;
    margin: 0;
    border-radius: 0;
    border-left-width: 0;
    border-right-width: 0;
    box-shadow: none;
  }
</style>
