---
import Button from './Button.astro';
import BrandMark from './BrandMark.astro';
import MobileMenu from './MobileMenu.svelte';
import { NIKOLAUS_CONFIG } from '../lib/nikolausConfig';

const nav = [
  { href: '/', label: 'Start' },
  // Only shown while the Nikolausdienst booking is active
  ...(NIKOLAUS_CONFIG.publicActive ? [{ href: '/nikolaus', label: 'Nikolaus' }] : []),
  { href: '/gruppenstunden', label: 'Gruppenstunden' },
  { href: '/aktionen', label: 'Aktionen' },
  { href: '/blog', label: 'Blog' },
  { href: '/downloads', label: 'Downloads' },
  { href: '/fragen-und-antworten', label: 'FAQ' },
  { href: '/vorstand', label: 'Vorstand' },
  { href: '/kontakt', label: 'Kontakt' },
];

const primaryNav = nav.filter((item) =>
  ['/', '/nikolaus', '/gruppenstunden', '/aktionen'].includes(item.href)
);
const secondaryNav = nav.filter((item) => !primaryNav.includes(item));
const mobileNav = [...primaryNav, { href: '/mitmachen', label: 'Mitmachen' }];

const staffLink = { href: '/leitendenbereich', label: 'Leitendenbereich' };

const currentPath = Astro.url?.pathname ?? '/';
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header id="site-nav" class="ui-header nav-shell relative w-full px-0">
  <div class="nav-inner relative flex w-full items-center gap-4 px-3 py-2 md:px-5 md:py-3">
    <a
      href="/"
      class="relative z-10 flex items-center gap-3 no-underline hover:no-underline"
      aria-label="Stamm Phoenix – DPSG Feldkirchen-Westerham"
    >
      <BrandMark kind="phoenix" decorative class="h-14 select-none md:h-16" />
      <span class="leading-tight">
        <span class="ui-wordmark block font-serif text-xl font-bold text-brand-900 md:text-2xl">
          Stamm Phoenix
        </span>
        <span class="mt-0.5 block text-sm text-neutral-700">DPSG Feldkirchen-Westerham</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden 2xl:block relative z-10" aria-label="Hauptnavigation">
      <ul class="flex items-center gap-1 md:gap-2">
        {primaryNav.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link inline-flex items-center px-3 py-2 text-sm font-semibold no-underline text-brand-900 decoration-2 underline-offset-8 hover:underline active:text-[var(--color-dpsg-red)] aria-[current=page]:underline aria-[current=page]:decoration-[var(--color-dpsg-red)]"
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="relative">
          <details class="site-more">
            <summary class="nav-link min-h-11 cursor-pointer px-3 py-2 text-sm font-semibold text-brand-900">
              Stamm & Hilfe
            </summary>
            <ul class="absolute right-0 top-full w-56 border border-neutral-300 bg-surface p-3 shadow-lift">
              {secondaryNav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="block py-2 text-sm text-brand-900"
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2 md:gap-4">
      <a
        href={staffLink.href}
        class="nav-link hidden 2xl:inline-flex items-center gap-2 px-3 py-2 text-sm font-semibold no-underline text-brand-900 decoration-2 underline-offset-8 hover:underline active:text-[var(--color-dpsg-red)] aria-[current=page]:underline aria-[current=page]:decoration-[var(--color-dpsg-red)]"
        aria-current={isCurrent(staffLink.href) ? 'page' : undefined}
      >
        <svg
          aria-hidden="true"
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="4" y="11" width="16" height="10" rx="2"></rect>
          <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
        </svg>
        {staffLink.label}
      </a>
      <div class="hidden 2xl:block">
        <Button href="/mitmachen" variant="cta">
          {' '}
          Mitmachen{' '}
        </Button>
      </div>
      <BrandMark kind="dpsg" class="hidden h-9 sm:inline-flex md:h-10" />
      <!-- Mobile and tablet: menu button (Svelte island), its panel opens on the right -->
      <MobileMenu
        nav={mobileNav}
        secondaryNav={secondaryNav}
        staffLink={staffLink}
        currentPath={currentPath}
        client:only="svelte"
      />
    </div>
  </div>
</header>

<style>
  .nav-shell {
    transition:
      padding 0.24s ease,
      transform 0.24s ease;
  }
  .nav-shell .nav-inner {
    transition:
      max-width 0.24s ease,
      border-radius 0.24s ease,
      box-shadow 0.24s ease,
      border-color 0.24s ease;
    max-width: none;
    margin: 0;
    border-radius: 0;
    border-left-width: 0;
    border-right-width: 0;
    box-shadow: none;
  }
</style>

<script>
  function closeExtraNavigation(): void {
    document.querySelectorAll<HTMLDetailsElement>('.site-more[open]').forEach((group) => {
      group.open = false;
    });
  }
  document.addEventListener('click', (event) => {
    if (
      !(event.target instanceof Element) ||
      !event.target.closest('.site-more') ||
      event.target.closest('a')
    )
      closeExtraNavigation();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const group = document.querySelector<HTMLDetailsElement>('.site-more[open]');
    group?.querySelector<HTMLElement>('summary')?.focus();
    closeExtraNavigation();
  });
  document.addEventListener('astro:before-swap', closeExtraNavigation);
</script>
