---
import Heading from './Heading.astro';

interface Props {
  title: string;
  id?: string;
  class?: string;
}

const { title, id, class: className = '' } = Astro.props;
---

<article id={id} class:list={['border-t-2 border-[var(--color-dpsg-blue)] pt-4', className]}>
  <Heading level={2} variant="card" class="mb-2">
    {title}
  </Heading>
  <slot />
</article>
