---
import Button from './Button.astro';

interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  description?: string;
  primaryButtonText?: string;
  primaryButtonLink?: string;
  secondaryButtonText?: string;
  secondaryButtonLink?: string;
}

const {
  badge,
  title,
  subtitle,
  description,
  primaryButtonText,
  primaryButtonLink,
  secondaryButtonText,
  secondaryButtonLink,
} = Astro.props;
---

<section
  id="main-content"
  class="ui-hero relative overflow-hidden rounded-[var(--radius-lg)] py-7 md:py-10 text-brand-900"
  aria-labelledby="page-title"
>
  <div class="grid items-center gap-10 md:grid-cols-[1fr_1.1fr]">
    <div class="hidden md:flex items-center justify-center">
      <div>
        <img
          src="/Logo_Phoenix_Neu_Vector.svg"
          alt=""
          width="360"
          height="360"
          class="w-90 h-90 object-contain"
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
    <div class="z-10 max-w-3xl space-y-4 md:order-2 order-1">
      {badge && <p class="badge text-neutral-800">{badge}</p>}
      <h1 id="page-title" class="mt-1 text-3xl md:text-5xl font-serif font-extrabold leading-tight">
        {title}
      </h1>
      {subtitle && <p class="mt-4 text-base md:text-lg text-neutral-800">{subtitle}</p>}
      {description && <p class="mt-3 text-base md:text-lg text-neutral-800">{description}</p>}
      {(primaryButtonText || secondaryButtonText) && (
        <div class="mt-6 flex flex-wrap gap-3">
          {primaryButtonText && primaryButtonLink && (
            <Button href={primaryButtonLink} variant="primary">
              {primaryButtonText}
            </Button>
          )}
          {secondaryButtonText && secondaryButtonLink && (
            <Button href={secondaryButtonLink} variant="secondary" arrow>
              {secondaryButtonText}
            </Button>
          )}
        </div>
      )}
    </div>
  </div>
</section>
