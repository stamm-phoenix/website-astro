---
import Heading from './Heading.astro';
import Tag from './Tag.astro';
import Text from './Text.astro';
import GroupLeaders from './GroupLeaders.svelte';

export type GroupKey = 'Woelflinge' | 'Jungpfadfinder' | 'Pfadfinder' | 'Rover';

interface Props {
  name: string;
  day: string;
  time: string;
  age: string;
  description?: string;
  groupKey: GroupKey;
}

const { name, day, time, age, description, groupKey } = Astro.props;

const groupConfig: Record<GroupKey, { color: string; logo: string }> = {
  Woelflinge: {
    color: 'var(--color-dpsg-woelflinge)',
    logo: '/stufen/woelflinge.webp',
  },
  Jungpfadfinder: {
    color: 'var(--color-dpsg-jupfis)',
    logo: '/stufen/jungpfadfinder.webp',
  },
  Pfadfinder: {
    color: 'var(--color-dpsg-pfadfinder)',
    logo: '/stufen/pfadfinder.webp',
  },
  Rover: {
    color: 'var(--color-dpsg-rover)',
    logo: '/stufen/rover.webp',
  },
};

const config = groupConfig[groupKey];
---

<article
  class="surface p-5 border-l-4 relative overflow-hidden"
  style={`border-left-color: ${config.color};`}
>
  <div
    class="absolute top-3 right-3 w-16 h-16 opacity-15 pointer-events-none bg-contain bg-no-repeat bg-center"
    style={`background-image: url('${config.logo}');`}
    aria-hidden="true"
  ></div>
  <div class="relative">
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3">
        <img
          src={config.logo}
          alt={`${name} Stufenlilie`}
          width="40"
          height="40"
          class="w-10 h-10 object-contain"
          loading="lazy"
          decoding="async"
        />
        <Heading level={2} variant="card">
          {name}
        </Heading>
      </div>
      <Tag style={`background-color: ${config.color}20; color: ${config.color};`}>{day}</Tag>
    </div>
    <Text class="mt-2">
      <strong>Alter:</strong> {age}
    </Text>
    <Text>
      <strong>Gruppenstunde:</strong> {day}, {time}
    </Text>
    <Text>
      <strong>Leitende:</strong>
      <GroupLeaders groupKey={groupKey} client:only="svelte">
        <span class="inline-block w-40 h-4 bg-[var(--color-neutral-200)] rounded animate-pulse align-middle"></span>
      </GroupLeaders>
    </Text>
    {description && (
      <Text variant="meta" class="mt-2">
        {description}
      </Text>
    )}
  </div>
</article>
