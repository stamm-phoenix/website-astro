---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import StaffFooter from './StaffFooter.astro';
import Heading from './Heading.astro';
import Aufgaben from './Aufgaben.svelte';
import AufgabenProjekte from './AufgabenProjekte.svelte';
import AufgabenVorlagen from './AufgabenVorlagen.svelte';
import AufgabenVorschlaege from './AufgabenVorschlaege.svelte';
interface Props {
  area?: 'aufgaben' | 'projekte' | 'vorlagen' | 'vorschlag';
  title?: string;
}
const { area = 'aufgaben', title = 'Aufgaben' } = Astro.props;
---

<BaseLayout
  title={`${title} | Leitendenbereich | Stamm Phoenix`}
  description="Aufgaben gemeinsam planen und erledigen."
>
  <Header slot="header" />

  <nav aria-label="Brotkrümelnavigation" class="mb-2 text-sm">
    <ol class="flex flex-wrap items-center gap-1.5 text-neutral-700">
      <li>
        <a href="/leitendenbereich" class="font-semibold text-link">
          Leitendenbereich
        </a>
      </li>
      <li aria-hidden="true">/</li>
      {area !== 'aufgaben' && (
        <>
          <li>
            <a class="text-link" href="/leitendenbereich/aufgaben" data-astro-reload>
              Aufgaben
            </a>
          </li>
          <li aria-hidden="true">/</li>
        </>
      )}
      <li aria-current="page">{title}</li>
    </ol>
  </nav>

  <header class="pb-3 md:pb-4">
    <Heading level={1} variant="section" class="mb-0!">
      {title}
    </Heading>
  </header>

  <div class="task-page mt-1">
    {area === 'projekte' ? (
      <AufgabenProjekte client:only="svelte" />
    ) : area === 'vorlagen' ? (
      <AufgabenVorlagen client:only="svelte" />
    ) : area === 'vorschlag' ? (
      <AufgabenVorschlaege client:only="svelte" />
    ) : (
      <Aufgaben client:only="svelte" />
    )}
    <noscript>
      <p class="border-t border-neutral-200 pt-4 text-sm text-neutral-800">
        Für diese Ansicht wird JavaScript benötigt.
      </p>
    </noscript>
  </div>

  <StaffFooter slot="footer" />
</BaseLayout>

<style is:global>
  body:has(.task-page) :is(input, textarea)::placeholder {
    color: var(--color-neutral-700);
    opacity: 1;
  }
  .task-page:has([data-toast] > div) {
    padding-bottom: 8rem;
  }
  body:has(.task-page)::before {
    display: none;
  }
  main:has(.task-page) {
    padding-block: 1.5rem;
  }
  main:has(.task-page) {
    scroll-margin-block-start: 8rem;
  }
  main:has(.task-page):focus {
    outline: none;
  }
  main:has(.task-page):focus-visible {
    box-shadow: inset 0 3px 0 var(--color-focus);
  }
  body:has(.task-page) > footer {
    z-index: 0;
    margin-top: 1.5rem;
  }
  @media (min-width: 768px) {
    main:has(.task-page) {
      padding-block: 2rem;
    }
  }
</style>
