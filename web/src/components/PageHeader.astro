---
import Heading from './Heading.astro';

interface Props {
  title: string;
  description?: string;
  compact?: boolean;
}

const { title, description, compact = false } = Astro.props;
---

<header
  class:list={[
    'ui-pagehead',
    compact ? 'pb-3 md:pb-4' : 'border-b border-[var(--color-neutral-200)] pb-6 md:pb-8',
  ]}
>
  <div class="prose max-w-3xl">
    <Heading level={1} variant="section">
      {title}
    </Heading>
    {description && <p class="text-neutral-800">{description}</p>}
    <slot />
  </div>
</header>
