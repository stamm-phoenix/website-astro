---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface BaseLayoutProps {
  title?: string;
  description?: string;
  image?: string;
  /** Description of `image` for social media previews */
  imageAlt?: string;
  /** Pixel size of `image`; omitted from the meta tags when unknown */
  imageWidth?: number;
  imageHeight?: number;
  ogType?: string;
  privatePage?: boolean;
}

// Raster image for shared links; social platforms do not reliably render SVG.
const DEFAULT_OG_IMAGE = {
  src: '/og-image.png',
  alt: 'Stamm Phoenix – DPSG Feldkirchen-Westerham, Stammeslilie mit Phoenix',
  width: 1200,
  height: 630,
  type: 'image/png',
};

const props = Astro.props as BaseLayoutProps;
const {
  title = 'Stamm Phoenix | Pfadfinden in Feldkirchen-Westerham',
  description = 'DPSG Stamm Phoenix Feldkirchen-Westerham – Gemeinschaft, Abenteuer und Verantwortung für Kinder und Jugendliche.',
  image = DEFAULT_OG_IMAGE.src,
  imageAlt = DEFAULT_OG_IMAGE.alt,
  imageWidth = image === DEFAULT_OG_IMAGE.src ? DEFAULT_OG_IMAGE.width : undefined,
  imageHeight = image === DEFAULT_OG_IMAGE.src ? DEFAULT_OG_IMAGE.height : undefined,
  ogType = 'website',
  privatePage = false,
} = props;

const siteUrl = Astro.site ?? new URL('https://stamm-phoenix.de');
const canonicalUrl = Astro.url?.href ?? new URL('/', siteUrl).href;
const ogImageUrl = new URL(image, siteUrl).href;

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'DPSG Stamm Phoenix Feldkirchen-Westerham',
  url: siteUrl.href,
  logo: new URL('/stammeslilie.svg', siteUrl).href,
  email: 'kontakt@stamm-phoenix.de',
  telephone: '+49 175 7539860',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: 'kontakt@stamm-phoenix.de',
      telephone: '+49 175 7539860',
      areaServed: 'DE',
      availableLanguage: ['de'],
    },
  ],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Stamm Phoenix',
  url: siteUrl.href,
  inLanguage: 'de-DE',
};
---

<html lang="de" class="bg-[var(--color-neutral-50)]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f5ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101b26" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        let choice;
        try {
          choice = localStorage.getItem('phoenix-theme');
        } catch {}
        if (choice === 'light' || choice === 'dark')
          document.documentElement.dataset.theme = choice;
        else delete document.documentElement.dataset.theme;
        const dark =
          choice === 'dark' ||
          (choice !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
          meta.removeAttribute('media');
          meta.setAttribute('content', dark ? '#101b26' : '#f8f5ef');
        });
      })();
    </script>
    <meta name="robots" content={privatePage ? 'noindex,nofollow' : 'index,follow'} />
    {privatePage && <meta name="referrer" content="no-referrer" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Stamm Phoenix" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {image === DEFAULT_OG_IMAGE.src && (
      <meta property="og:image:type" content={DEFAULT_OG_IMAGE.type} />
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)}></script>
    <ClientRouter />
  </head>
  <body class="relative overflow-x-hidden">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-surface focus:text-brand-900 focus:p-2 focus:rounded focus:shadow-lift"
    >
      Zum Inhalt springen
    </a>

    <header class="ui-topbar sticky top-0 z-50 border-b border-[var(--color-neutral-200)] bg-surface">
      <slot name="header" />
      <div class="ui-topbar-line h-1 w-full bg-danger"></div>
    </header>

    <main id="main" tabindex="-1" class="container py-8 md:py-12 relative z-10">
      <slot />
    </main>

    <footer class="ui-footer mt-12 border-t border-[var(--color-neutral-200)] bg-surface relative z-10">
      <slot name="footer" />
    </footer>
  </body>
</html>

<script>
  import { initTheme } from '../lib/theme';
  initTheme();
  import {
    FAHRT_OWNER_KEY,
    FAHRT_STORAGE_KEY,
    readFahrtSnapshot,
  } from '../lib/nikolausFahrtOffline';

  // Expiry is checked on every site visit, even outside the Fahrt view.
  function expireStoredRoute(): void {
    try {
      const raw = localStorage.getItem(FAHRT_STORAGE_KEY);
      if (raw) {
        const owner = (JSON.parse(raw) as { owner?: unknown }).owner;
        readFahrtSnapshot(typeof owner === 'string' ? owner : '');
      }
    } catch {
      try {
        localStorage.removeItem(FAHRT_STORAGE_KEY);
      } catch {
        /* Storage unavailable. */
      }
    }
  }
  expireStoredRoute();
  document.addEventListener('astro:page-load', expireStoredRoute);
  document.addEventListener('click', (event) => {
    if (
      event.target instanceof Element &&
      event.target.closest('a[href="/logout"], a[href^="/.auth/logout"]')
    ) {
      try {
        localStorage.removeItem(FAHRT_STORAGE_KEY);
        sessionStorage.removeItem(FAHRT_OWNER_KEY);
      } catch {
        /* Storage unavailable. */
      }
    }
  });
</script>
