---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

// Switcher for the UI variants of Issue #97 (dev server and PR previews); the constant condition
// drops it from production builds.
const UiSwitcher =
  import.meta.env.DEV || import.meta.env.UI_PREVIEW
    ? (await import('../../dev/ui-varianten/UiSwitcher.astro')).default
    : null;

interface BaseLayoutProps {
  title?: string;
  description?: string;
  image?: string;
  /** Description of `image` for social media previews */
  imageAlt?: string;
  ogType?: string;
  privatePage?: boolean;
}

const props = Astro.props as BaseLayoutProps;
const {
  title = 'Stamm Phoenix | Pfadfinden in Feldkirchen-Westerham',
  description = 'DPSG Stamm Phoenix Feldkirchen-Westerham – Gemeinschaft, Abenteuer und Verantwortung für Kinder und Jugendliche.',
  image = '/stammeslilie.svg',
  imageAlt = 'Stamm Phoenix Logo',
  ogType = 'website',
  privatePage = false,
} = props;

const siteUrl = Astro.site ?? new URL('https://stamm-phoenix.de');
const canonicalUrl = Astro.url?.href ?? new URL('/', siteUrl).href;
const ogImageUrl = new URL(image, siteUrl).href;

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'DPSG Stamm Phoenix Feldkirchen-Westerham',
  url: siteUrl.href,
  logo: new URL('/stammeslilie.svg', siteUrl).href,
  email: 'kontakt@stamm-phoenix.de',
  telephone: '+49 175 7539860',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: 'kontakt@stamm-phoenix.de',
      telephone: '+49 175 7539860',
      areaServed: 'DE',
      availableLanguage: ['de'],
    },
  ],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Stamm Phoenix',
  url: siteUrl.href,
  inLanguage: 'de-DE',
};
---

<html lang="de" class="bg-[var(--color-neutral-50)]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#003056" />
    <meta name="robots" content={privatePage ? 'noindex,nofollow' : 'index,follow'} />
    {privatePage && <meta name="referrer" content="no-referrer" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Stamm Phoenix" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)}></script>
    <ClientRouter />
    {UiSwitcher && <UiSwitcher part="head" />}
  </head>
  <body class="relative overflow-x-hidden">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-white focus:text-brand-900 focus:p-2 focus:rounded focus:shadow-lift"
    >
      Zum Inhalt springen
    </a>

    <header class="ui-topbar sticky top-0 z-50 border-b border-[var(--color-neutral-200)] bg-white">
      <slot name="header" />
      <div class="ui-topbar-line h-1 w-full bg-[var(--color-dpsg-red)]"></div>
    </header>

    <main id="main" tabindex="-1" class="container py-8 md:py-12 relative z-10">
      <slot />
    </main>

    <footer class="ui-footer mt-12 border-t border-[var(--color-neutral-200)] bg-white relative z-10">
      <slot name="footer" />
    </footer>
    {UiSwitcher && <UiSwitcher part="panel" />}
  </body>
</html>

<script>
  import {
    FAHRT_OWNER_KEY,
    FAHRT_STORAGE_KEY,
    readFahrtSnapshot,
  } from '../lib/nikolausFahrtOffline';

  // Expiry is checked on every site visit, even outside the Fahrt view.
  function expireStoredRoute(): void {
    try {
      const raw = localStorage.getItem(FAHRT_STORAGE_KEY);
      if (raw) {
        const owner = (JSON.parse(raw) as { owner?: unknown }).owner;
        readFahrtSnapshot(typeof owner === 'string' ? owner : '');
      }
    } catch {
      try {
        localStorage.removeItem(FAHRT_STORAGE_KEY);
      } catch {
        /* Storage unavailable. */
      }
    }
  }
  expireStoredRoute();
  document.addEventListener('astro:page-load', expireStoredRoute);
  document.addEventListener('click', (event) => {
    if (
      event.target instanceof Element &&
      event.target.closest('a[href="/logout"], a[href^="/.auth/logout"]')
    ) {
      try {
        localStorage.removeItem(FAHRT_STORAGE_KEY);
        sessionStorage.removeItem(FAHRT_OWNER_KEY);
      } catch {
        /* Storage unavailable. */
      }
    }
  });
</script>
