---
import BaseLayout from './BaseLayout.astro';
import StaffHeader from '../components/StaffHeader.astro';
import StaffNav from '../components/StaffNav.svelte';
import StaffSidebar from '../components/StaffSidebar.svelte';
import { SIDEBAR_KEY } from '../lib/staffSidebar';
import StaffIntro from '../components/StaffIntro.svelte';
import StaffFooter from '../components/StaffFooter.astro';
import GeretteteEingaben from '../components/GeretteteEingaben.svelte';
import PageHeader from '../components/PageHeader.astro';
import {
  NIKOLAUS_CONTROL_MODULE,
  NIKOLAUS_MODULES,
  STAFF_MODULE_SECTIONS,
  staffBreadcrumbs,
  staffModuleOf,
  staffPage,
} from '../lib/staffModules';

interface Props {
  /**
   * Who renders the h1: `page` shows heading and intro, `sr-only` a heading for screen readers,
   * `none` leaves it to the content.
   */
  header?: 'page' | 'sr-only' | 'none';
  /** Only the content, for views shown in a window of their own. */
  bare?: boolean;
  /** Less space below the intro, for modules whose content must start high up on a phone. */
  compact?: boolean;
  /** Off for modules that say themselves what works without a connection. */
  offlineNotice?: boolean;
}

const { header = 'page', bare = false, compact = false, offlineNotice = true } = Astro.props;
const page = staffPage(Astro.url.pathname);
const heading = page.heading ?? page.title;
const breadcrumbs = staffBreadcrumbs(page);
// One step up: the page above, or the start page („Übersicht“)
const back = breadcrumbs.at(-1);
const sections = STAFF_MODULE_SECTIONS.filter((section) => section.modules.length > 0);
const navProps = {
  sections,
  nikolausModules: NIKOLAUS_MODULES,
  nikolausControl: NIKOLAUS_CONTROL_MODULE,
  current: page.href,
  ancestors: breadcrumbs.map((ancestor) => ancestor.href),
};
const intro = page.intro ?? page.description;
const title =
  breadcrumbs.length === 0
    ? `${heading} | Stamm Phoenix`
    : `${heading} | Leitendenbereich | Stamm Phoenix`;
---

<BaseLayout
  {title}
  description={page.description}
  privatePage
  {bare}
  wide
  skipTarget="staff-content"
>
  <Fragment slot="head">
    <!-- Installable from the home screen; route-only offline opt-in, see docs/leitendenbereich-app.md -->
    <link rel="manifest" href="/leitendenbereich.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Leitende" />
  </Fragment>
  <StaffHeader slot="header" />

  <div class:list={{ 'xl:flex xl:items-start xl:gap-8': !bare }}>
    {!bare && <script is:inline define:vars={{ key: SIDEBAR_KEY }}>
      // Before the sidebar shows: its last state on this device, so a full page load does
      // not unfold it until the saved settings arrive
      try {
        const value = localStorage.getItem(key);
        if (value) document.documentElement.dataset.staffSidebar = value;
      } catch {}
    </script>}
    {/* Kept across page changes, so it neither flashes nor loses its state */}
    {!bare && <StaffSidebar {...navProps} client:load transition:persist="staff-sidebar" />}

    <!-- „Zum Inhalt springen“ leads here, past the sidebar -->
    <div id="staff-content" tabindex="-1" class="min-w-0 flex-1">
      {/* Only shows something after a new login in the iPhone app, read from this tab */}
      {!bare && <GeretteteEingaben client:only="svelte" />}
      {!bare && offlineNotice && (
        // Without a service worker pages and data need the connection; shown by the script below
        <div role="status" aria-live="polite">
          <p
            data-offline-notice
            hidden
            class="mb-4 border-l-4 border-warning py-1 pl-3 text-warning"
          >
            <strong>Keine Verbindung zum Internet.</strong>{' '}
            {/* A module that keeps working offline says so in its own words */}
            <slot name="offline">
              Lass diese Seite offen, deine Eingaben bleiben stehen. Speichern und andere Seiten
              gehen erst wieder, wenn du online bist.
            </slot>
          </p>
        </div>
      )}
      {!bare && back && (
        <nav aria-label="Zurück" class="-mt-4 mb-2 md:-mt-6">
          <a
            href={back.href}
            data-astro-reload={back.reload}
            class="-ml-1 inline-flex min-h-11 items-center gap-1 pr-2 text-sm font-semibold text-link"
          >
            <svg
              aria-hidden="true"
              class="size-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M15 6l-6 6 6 6" />
            </svg>
            {breadcrumbs.length === 1 ? 'Übersicht' : (back.heading ?? back.title)}
          </a>
        </nav>
      )}

      {header === 'page' && (
        <PageHeader title={heading} hasActions={Astro.slots.has('actions')} tight>
          {intro && !page.introOpen && (
            <StaffIntro slot="beside-title" {heading} {intro} client:load />
          )}
          {intro && page.introOpen && <StaffIntro {heading} {intro} open />}
          <slot name="header" />
          <slot name="actions" slot="actions" />
        </PageHeader>
      )}
      {header === 'sr-only' && <h1 class="sr-only">{heading}</h1>}

      <div
        class="staff-page"
        class:list={{
          'mt-4': header === 'page' && !compact,
          'mt-2': (header === 'page' && compact) || (header === 'sr-only' && !bare),
        }}
      >
        <slot />
        <noscript>
          <p class="border-t border-neutral-200 pt-4 text-sm text-neutral-800">
            Für diese Ansicht wird JavaScript benötigt.
          </p>
        </noscript>
      </div>
    </div>
  </div>

  {!bare && <StaffNav {...navProps} module={staffModuleOf(page)?.href} client:load />}

  <StaffFooter slot="footer" />
</BaseLayout>

<script>
  import { loginUrl, reloginOnlyHere } from '../lib/api';

  // In the iPhone app a link opening a new window goes to Safari, which has its own login. A
  // protected page is opened through the login there, which comes back to it.
  const PROTECTED = /^\/(leitendenbereich|api\/intern)(\/|$)/;
  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || !reloginOnlyHere() || !(event.target instanceof Element)) return;
    const link = event.target.closest('a[target="_blank"]');
    if (!(link instanceof HTMLAnchorElement) || link.origin !== location.origin) return;
    if (!PROTECTED.test(link.pathname)) return;
    event.preventDefault();
    window.open(loginUrl(`${link.pathname}${link.search}${link.hash}`), '_blank', 'noopener');
  });

  function showOfflineNotice(): void {
    document.querySelector('[data-offline-notice]')?.toggleAttribute('hidden', navigator.onLine);
  }
  window.addEventListener('online', showOfflineNotice);
  window.addEventListener('offline', showOfflineNotice);
  document.addEventListener('astro:page-load', showOfflineNotice);
</script>

<style>
  :global(html:has(#staff-content)) {
    scroll-padding-top: 6rem;
  }
</style>
