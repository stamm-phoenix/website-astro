---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EssensplanungApp from '../../components/essensplanung/EssensplanungApp.svelte';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  privatePage
  title="Essensplanung | Stamm Phoenix"
  description="Eine Essensplanung ansehen und bearbeiten."
>
  <Header slot="header" />
  <div class="essensplanung-seite">
    <EssensplanungApp client:only="svelte" />
    <noscript>
      <p class="border-t border-neutral-200 pt-4 text-sm text-neutral-800">
        Die Essensplanung braucht JavaScript.
      </p>
    </noscript>
  </div>
  <Footer slot="footer" />
</BaseLayout>

<style is:global>
  /* A working tool: the Planung uses the whole width of the screen instead of the site's column */
  main:has(.essensplanung-seite) {
    max-width: none;
    padding-top: 1rem;
    padding-bottom: 1.5rem;
  }
  @media (min-width: 64rem) {
    main:has(.essensplanung-seite) {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }
  /*
   * One height for buttons and fields with a mouse: 32 px, as dense as the lists of the Planung.
   * On touch screens they keep 44 px for a finger. Unlayered, so it wins over the utilities;
   * the repeated classes outweigh the scoped styles of the shared components.
   */
  @media not (any-pointer: coarse) {
    .essensplanung-seite :is(.btn-primary, .btn-secondary, .btn-danger, .btn-danger-filled) {
      min-height: 2rem;
      padding-block: 0.25rem;
      padding-inline: 0.75rem;
      font-size: 0.875rem;
      line-height: 1.25rem;
    }
    .essensplanung-seite :is(input.form-input, select.form-input) {
      min-height: 2rem;
      padding-block: 0.25rem;
      font-size: 0.875rem;
      line-height: 1.25rem;
    }
    .essensplanung-seite .filter-tab.filter-tab {
      min-height: 2rem;
      padding-block: 0.25rem;
    }
    .essensplanung-seite.essensplanung-seite .segments.segments {
      padding: 0.125rem;
    }
    .essensplanung-seite.essensplanung-seite .segments .filter-tab.filter-tab {
      min-height: 1.75rem;
      padding-block: 0.125rem;
    }
    .essensplanung-seite .tool.tool {
      min-width: 2rem;
      min-height: 2rem;
    }
    .essensplanung-seite .copy-code.copy-code.copy-code {
      min-height: 2rem;
      padding-block: 0.25rem;
    }
    /* The (i) next to a label does not make the label line taller than its neighbours */
    .essensplanung-seite .info-hint-button.info-hint-button {
      width: 2rem;
      height: 2rem;
      margin-block: -0.375rem;
    }
    .essensplanung-seite .form-field:has(> .info-hint) {
      line-height: 1.25rem;
    }
  }
  /* On paper only the Planung or the recipe card, without the site around it */
  @media print {
    body:has(.essensplanung-seite) > header,
    body:has(.essensplanung-seite) > footer {
      display: none;
    }
  }
</style>
