---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import EssensplanungApp from '../../components/essensplanung/EssensplanungApp.svelte';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  privatePage
  title="Essensplanung | Stamm Phoenix"
  description="Eine Essensplanung ansehen und bearbeiten."
>
  <Header slot="header" />
  <div class="print:hidden">
    <PageHeader title="Essensplanung" />
  </div>
  <div class="essensplanung-seite mt-8 print:mt-0">
    <EssensplanungApp client:only="svelte" />
    <noscript>
      <p class="border-t border-neutral-200 pt-4 text-sm text-neutral-800">
        Die Essensplanung braucht JavaScript.
      </p>
    </noscript>
  </div>
  <Footer slot="footer" />
</BaseLayout>

<style is:global>
  /* On paper only the Planung or the recipe card, without the site around it */
  @media print {
    body:has(.essensplanung-seite) > header,
    body:has(.essensplanung-seite) > footer {
      display: none;
    }
  }
</style>
