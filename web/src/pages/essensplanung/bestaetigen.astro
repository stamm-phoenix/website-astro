---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import EssensplanungLinkSeite from '../../components/essensplanung/EssensplanungLinkSeite.svelte';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  privatePage
  title="Planung anlegen | Stamm Phoenix"
  description="Eine neue Essensplanung bestätigen."
>
  <Header slot="header" />
  <PageHeader title="Planung anlegen" />
  <div class="mt-8">
    <EssensplanungLinkSeite client:only="svelte" art="bestaetigen" />
    <noscript>
      <p class="border-t border-neutral-200 pt-4 text-sm text-neutral-800">
        Die Essensplanung braucht JavaScript.
      </p>
    </noscript>
  </div>
  <Footer slot="footer" />
</BaseLayout>
