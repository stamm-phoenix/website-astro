---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import Aufgaben from '../../components/Aufgaben.svelte';
---

<BaseLayout
  watermark={false}
  compactContent
  title="Aufgaben | Leitendenbereich | Stamm Phoenix"
  description="Aufgaben gemeinsam planen und erledigen."
>
  <Header slot="header" />

  <nav aria-label="Brotkrümelnavigation" class="mb-4 text-sm">
    <ol class="flex flex-wrap items-center gap-1.5 text-neutral-700">
      <li>
        <a href="/leitendenbereich" class="font-semibold text-link">
          Leitendenbereich
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Aufgaben</li>
    </ol>
  </nav>

  <PageHeader title="Aufgaben" compact />

  <div class="mt-3">
    <Aufgaben client:only="svelte" />
    <noscript>
      <p class="border-t border-neutral-200 pt-4 text-sm text-neutral-800">
        Für diese Ansicht wird JavaScript benötigt.
      </p>
    </noscript>
  </div>

  <Footer slot="footer" />
</BaseLayout>
