---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import QrCodeGenerator from '../../components/qrcode/QrCodeGenerator.svelte';
---

<BaseLayout
  title="QR-Code | Leitendenbereich | Stamm Phoenix"
  description="QR-Codes für Links und Texte erstellen, mit eigener Farbe und Form, und als PNG herunterladen."
>
  <Header slot="header" />

  <nav aria-label="Brotkrümelnavigation" class="mb-4 text-sm">
    <ol class="flex flex-wrap items-center gap-1.5 text-neutral-700">
      <li>
        <a href="/leitendenbereich" class="font-semibold text-link">
          Leitendenbereich
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">QR-Code</li>
    </ol>
  </nav>

  <PageHeader
    title="QR-Code"
    description="QR-Code für einen Link oder Text erstellen, Farbe und Form anpassen und als PNG herunterladen. Alles passiert im Browser: ohne fremden Dienst, ohne Weiterleitung und ohne Ablaufdatum."
  />

  <div class="mt-8">
    <QrCodeGenerator client:only="svelte" />
    <noscript>
      <p class="surface p-6 text-sm text-neutral-800">
        Für diese Ansicht wird JavaScript benötigt.
      </p>
    </noscript>
  </div>

  <Footer slot="footer" />
</BaseLayout>
