---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHeader from '../../../components/PageHeader.astro';
import BlogPflege from '../../../components/pflege/BlogPflege.svelte';
---

<BaseLayout
  title="Blog | Leitendenbereich | Stamm Phoenix"
  description="Blogbeiträge schreiben, bebildern und veröffentlichen."
>
  <Header slot="header" />

  <nav aria-label="Brotkrümelnavigation" class="mb-4 text-sm">
    <ol class="flex flex-wrap items-center gap-1.5 text-neutral-700">
      <li>
        <a href="/leitendenbereich" class="font-semibold text-link">
          Leitendenbereich
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Blog</li>
    </ol>
  </nav>

  <PageHeader
    title="Blog"
    description="Blogbeiträge schreiben, bebildern und veröffentlichen. Entwürfe sind nur hier sichtbar."
  />

  <div class="mt-8">
    <BlogPflege client:only="svelte" />
    <noscript>
      <p class="border-t border-neutral-200 pt-4 text-sm text-neutral-800">
        Für diese Ansicht wird JavaScript benötigt.
      </p>
    </noscript>
  </div>

  <Footer slot="footer" />
</BaseLayout>
