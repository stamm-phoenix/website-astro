---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import EigenbelegGenerator from '../../components/eigenbeleg/EigenbelegGenerator.svelte';
---

<BaseLayout
  title="Eigenbeleg | Leitendenbereich | Stamm Phoenix"
  description="Einen Eigenbeleg auf dem Briefpapier des Stammes erstellen, wenn es für eine Ausgabe keinen Originalbeleg gibt."
>
  <Header slot="header" />

  <nav aria-label="Brotkrümelnavigation" class="mb-4 text-sm">
    <ol class="flex flex-wrap items-center gap-1.5 text-neutral-700">
      <li>
        <a href="/leitendenbereich" class="font-semibold text-link">
          Leitendenbereich
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Eigenbeleg</li>
    </ol>
  </nav>

  <PageHeader
    title="Eigenbeleg"
    description="Für Ausgaben ohne Originalbeleg, z. B. am Parkautomaten oder bei einem verlorenen Kassenzettel: ausfüllen, als PDF herunterladen, unterschreiben und wie einen Kassenbeleg unter „Belege“ einreichen."
  />

  <div class="mt-8">
    <EigenbelegGenerator client:only="svelte" />
    <noscript>
      <p class="surface p-6 text-sm text-neutral-800">
        Für diese Ansicht wird JavaScript benötigt.
      </p>
    </noscript>
  </div>

  <Footer slot="footer" />
</BaseLayout>
