---
import StaffLayout from '../../../layouts/StaffLayout.astro';
import PostfachWeiter from '../../../components/postfach/PostfachWeiter.svelte';
import { POSTFAECHER } from '../../../../../api/lib/postfach-liste';

// Old addresses of single mailboxes, e.g. in mails about an assignment: they lead on to the module
export function getStaticPaths() {
  return POSTFAECHER.map((postfach) => ({
    params: { postfach: postfach.id },
    props: { id: postfach.id },
  }));
}

const { id } = Astro.props;
---

<!-- bare: no menu, so the visit is recorded once, on the page it leads to -->
<StaffLayout bare>
  <PostfachWeiter postfach={id} client:only="svelte" />
</StaffLayout>
