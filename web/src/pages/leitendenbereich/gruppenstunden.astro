---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import GruppenstundenPflege from '../../components/pflege/GruppenstundenPflege.svelte';
---

<BaseLayout
  title="Gruppenstunden | Leitendenbereich | Stamm Phoenix"
  description="Wochentage, Uhrzeiten, Orte und Beschreibungen der Gruppenstunden bearbeiten. Änderungen erscheinen sofort auf der Website."
>
  <Header slot="header" />

  <nav aria-label="Brotkrümelnavigation" class="mb-4 text-sm">
    <ol class="flex flex-wrap items-center gap-1.5 text-neutral-700">
      <li>
        <a href="/leitendenbereich" class="font-semibold text-brand-800">
          Leitendenbereich
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Gruppenstunden</li>
    </ol>
  </nav>

  <PageHeader
    title="Gruppenstunden"
    description="Wochentage, Uhrzeiten, Orte und Beschreibungen der Gruppenstunden bearbeiten. Änderungen erscheinen sofort auf der Website."
  />

  <div class="mt-8">
    <GruppenstundenPflege client:only="svelte" />
    <noscript>
      <p class="surface p-6 text-sm text-neutral-800">
        Für diese Ansicht wird JavaScript benötigt.
      </p>
    </noscript>
  </div>

  <Footer slot="footer" />
</BaseLayout>
