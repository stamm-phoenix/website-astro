---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import NikolausDispo from '../../components/NikolausDispo.svelte';
---

<BaseLayout
  title="Nikolaus-Dispo | Leitendenbereich | Stamm Phoenix"
  description="Verteilung der Nikolaus-Termine auf die Teams."
>
  <Header slot="header" />

  <nav aria-label="Brotkrümelnavigation" class="mb-4 text-sm print:hidden">
    <ol class="flex flex-wrap items-center gap-1.5 text-neutral-700">
      <li>
        <a href="/leitendenbereich" class="font-semibold text-brand-800">
          Leitendenbereich
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li>
        <a href="/leitendenbereich/nikolaus" class="font-semibold text-brand-800">
          Nikolaus
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Dispo</li>
    </ol>
  </nav>

  <div class="print:hidden">
    <PageHeader
      title="Nikolaus-Dispo"
      description="Verteilt die bestätigten Termine eines Tages auf die Teams, mit möglichst wenig Fahrzeit und ohne Verspätungen. Termine lassen sich von Hand umhängen; fixierte Termine behalten beim Neuberechnen ihr Team."
    />
  </div>

  <div class="mt-8 print:mt-0">
    <NikolausDispo client:only="svelte" />
    <noscript>
      <p class="surface p-6 text-sm text-neutral-800">
        Für diese Ansicht wird JavaScript benötigt.
      </p>
    </noscript>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style is:global>
  @media print {
    body > header,
    body > footer {
      display: none;
    }
  }
</style>
