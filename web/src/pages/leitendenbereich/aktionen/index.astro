---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CampflowEvents from '../../../components/CampflowEvents.svelte';
---

<BaseLayout
  title="Aktionen | Leitendenbereich | Stamm Phoenix"
  description="Aktionen aus CampFlow und der öffentliche Aktionskalender."
>
  <Header slot="header" />

  <nav aria-label="Brotkrümelnavigation" class="mb-4 text-sm">
    <ol class="flex flex-wrap items-center gap-1.5 text-neutral-700">
      <li>
        <a href="/leitendenbereich" class="font-semibold text-brand-800">
          Leitendenbereich
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Aktionen</li>
    </ol>
  </nav>

  <PageHeader
    title="Aktionen"
    description="Alle Aktionen aus CampFlow, neueste zuerst. Öffne eine Aktion für die Teilnehmendenliste oder veröffentliche sie im Kalender der Website. Aktionen ohne CampFlow legst du hier ebenfalls an."
  />

  <div class="mt-8">
    <CampflowEvents client:only="svelte" />
    <noscript>
      <p class="surface p-6 text-sm text-neutral-800">
        Für diese Ansicht wird JavaScript benötigt.
      </p>
    </noscript>
  </div>

  <Footer slot="footer" />
</BaseLayout>
