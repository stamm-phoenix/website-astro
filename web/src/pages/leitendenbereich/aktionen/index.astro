---
import StaffLayout from '../../../layouts/StaffLayout.astro';
import TextLink from '../../../components/TextLink.astro';
import CampflowEvents from '../../../components/CampflowEvents.svelte';
import InfoHint from '../../../components/ui/InfoHint.svelte';

const LEITENDE_ICS_URL = '/api/leitende.ics';
const PUBLIC_ICS_URL = '/api/aktionen.ics';
---

<StaffLayout>
  <p slot="header" class="text-sm">
    Kalender abonnieren: <TextLink href={LEITENDE_ICS_URL}>Leitenden-Kalender</TextLink>
    <InfoHint
      client:load
      label="Leitenden-Kalender"
      text="Enthält nur Aktionen mit der Stufe „Leitende“."
      class="ml-1"
    />{' '}
    · <TextLink href={PUBLIC_ICS_URL}>Öffentlicher Kalender</TextLink>
  </p>

  <CampflowEvents client:only="svelte" />
</StaffLayout>
