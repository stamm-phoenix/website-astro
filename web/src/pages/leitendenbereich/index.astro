---
import StaffLayout from '../../layouts/StaffLayout.astro';
import StaffDashboard from '../../components/StaffDashboard.svelte';
import StaffGreeting from '../../components/StaffGreeting.svelte';
import NikolausStaffNotice from '../../components/NikolausStaffNotice.svelte';
import StaffModuleSection from '../../components/StaffModuleSection.svelte';
import NikolausStaffSection from '../../components/NikolausStaffSection.svelte';
import { STAFF_MODULE_SECTIONS } from '../../lib/staffModules';
---

<StaffLayout header="none">
  <section class="border-b border-neutral-200 pb-6" aria-label="Anmeldung">
    <StaffGreeting client:only="svelte" />
  </section>

  <div class="mt-6">
    <NikolausStaffNotice client:only="svelte" />
  </div>

  <StaffDashboard client:only="svelte" />

  {STAFF_MODULE_SECTIONS.filter((section) => section.modules.length > 0).map((section) => (
    <StaffModuleSection
      title={section.title}
      modules={section.modules}
      initiallyOpen={section.id === 'organisation'}
    />
  ))}

  <NikolausStaffSection client:only="svelte" />
</StaffLayout>
