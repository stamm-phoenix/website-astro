---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import BelegePflege from '../../components/pflege/BelegePflege.svelte';
---

<BaseLayout
  title="Belege | Leitendenbereich | Stamm Phoenix"
  description="Belege fotografieren und bei der Kasse einreichen. Die Kasse prüft sie vor und überträgt angenommene Belege nach CampFlow."
>
  <Header slot="header" />

  <nav aria-label="Brotkrümelnavigation" class="mb-4 text-sm">
    <ol class="flex flex-wrap items-center gap-1.5 text-neutral-700">
      <li>
        <a href="/leitendenbereich" class="font-semibold text-link">
          Leitendenbereich
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Belege</li>
    </ol>
  </nav>

  <PageHeader
    title="Belege"
    description="Belege fotografieren und bei der Kasse einreichen. Die Kasse prüft sie vor und überträgt angenommene Belege nach CampFlow."
  />

  <div class="mt-8">
    <BelegePflege client:only="svelte" />
    <noscript>
      <p class="surface p-6 text-sm text-neutral-800">
        Für diese Ansicht wird JavaScript benötigt.
      </p>
    </noscript>
  </div>

  <Footer slot="footer" />
</BaseLayout>
