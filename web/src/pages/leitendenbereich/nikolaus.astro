---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import NikolausAdmin from '../../components/NikolausAdmin.svelte';
---

<BaseLayout
  title="Nikolaus-Anmeldungen | Leitendenbereich | Stamm Phoenix"
  description="Übersicht der Anmeldungen zum Nikolausdienst."
>
  <Header slot="header" />

  <nav aria-label="Brotkrümelnavigation" class="mb-4 text-sm">
    <ol class="flex flex-wrap items-center gap-1.5 text-neutral-700">
      <li>
        <a href="/leitendenbereich" class="font-semibold text-brand-800">
          Leitendenbereich
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Nikolaus</li>
    </ol>
  </nav>

  <PageHeader
    title="Nikolaus-Anmeldungen"
    description="Alle Anmeldungen zum Nikolausdienst – als filterbare Liste oder als Matrix über Tage und Zeitslots."
  />

  <div class="mt-8">
    <NikolausAdmin client:only="svelte" />
    <noscript>
      <p class="surface p-6 text-sm text-neutral-800">
        Für diese Ansicht wird JavaScript benötigt.
      </p>
    </noscript>
  </div>

  <Footer slot="footer" />
</BaseLayout>
