---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import SammelStaff from '../../components/sammelbestellungen/SammelStaff.svelte';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  privatePage
  title="Sammelbestellungen | Leitendenbereich | Stamm Phoenix"
  description="Sammelbestellungen anlegen, Bestelllisten prüfen und Zahlung sowie Auslieferung pflegen."
>
  <Header slot="header" />
  <nav aria-label="Brotkrümelnavigation" class="mb-4 text-sm">
    <ol class="flex flex-wrap gap-2 text-neutral-700">
      <li>
        <a href="/leitendenbereich" class="font-semibold text-brand-800">
          Leitendenbereich
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Sammelbestellungen</li>
    </ol>
  </nav>
  <PageHeader
    title="Sammelbestellungen"
    description="Bestellzeiträume anlegen, Mitglieder einladen und die Rüsthaus-Bestellungen verwalten."
  />
  <div class="mt-8">
    <SammelStaff client:load />
    <noscript>
      <p class="surface p-6">Zum Verwalten der Sammelbestellungen wird JavaScript benötigt.</p>
    </noscript>
  </div>
  <Footer slot="footer" />
</BaseLayout>
