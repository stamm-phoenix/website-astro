---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ProtokollEditor from '../../../components/protokolle/ProtokollEditor.svelte';
---

<BaseLayout
  title="Protokoll | Leitendenbereich | Stamm Phoenix"
  description="Ein Protokoll der Leitendenrunde schreiben oder live mitlesen."
>
  <Header slot="header" />

  <nav aria-label="Brotkrümelnavigation" class="brotkruemel mb-4 text-sm">
    <ol class="flex flex-wrap items-center gap-1.5 text-neutral-700">
      <li>
        <a href="/leitendenbereich" class="font-semibold text-link">
          Leitendenbereich
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li>
        <a href="/leitendenbereich/protokolle" class="font-semibold text-link">
          Protokolle
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Protokoll</li>
    </ol>
  </nav>

  <h1 class="sr-only">Protokoll</h1>

  <div class="mt-4">
    <ProtokollEditor client:only="svelte" />
    <noscript>
      <p class="border-t border-neutral-200 pt-4 text-sm text-neutral-800">
        Für diese Ansicht wird JavaScript benötigt.
      </p>
    </noscript>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style is:global>
  /* Printing the read view gives the minutes without the site around them (#298) */
  @media print {
    body > header,
    body > footer,
    .brotkruemel {
      display: none;
    }
  }
</style>
