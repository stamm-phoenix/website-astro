---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHeader from '../../../components/PageHeader.astro';
import AbrechnungList from '../../../components/abrechnung/AbrechnungList.svelte';
---

<BaseLayout
  privatePage
  title="Abrechnung | Leitendenbereich | Stamm Phoenix"
  description="Finanzübersicht und KJR-Zuschuss der Aktionen aus CampFlow."
>
  <Header slot="header" />

  <nav aria-label="Brotkrümelnavigation" class="mb-4 text-sm">
    <ol class="flex flex-wrap items-center gap-1.5 text-neutral-700">
      <li>
        <a href="/leitendenbereich" class="font-semibold text-brand-800">
          Leitendenbereich
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Abrechnung</li>
    </ol>
  </nav>

  <PageHeader
    title="Abrechnung"
    description="Wähle eine Aktion, um Teilnehmende, Einnahmen und Ausgaben sowie den möglichen Zuschuss vom Kreisjugendring Rosenheim zu sehen."
  />

  <div class="mt-8">
    <AbrechnungList client:only="svelte" />
    <noscript>
      <p class="surface p-6 text-sm text-neutral-800">
        Für diese Ansicht wird JavaScript benötigt.
      </p>
    </noscript>
  </div>

  <Footer slot="footer" />
</BaseLayout>
