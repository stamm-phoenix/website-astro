---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import MitschriftAnsicht from '../../../components/mitschriften/MitschriftAnsicht.svelte';
---

<BaseLayout
  title="Mitschrift | Leitendenbereich | Stamm Phoenix"
  description="Transkript und Notizen eines Meetings."
>
  <Header slot="header" />

  <nav aria-label="Brotkrümelnavigation" class="mb-4 text-sm">
    <ol class="flex flex-wrap items-center gap-1.5 text-neutral-700">
      <li>
        <a href="/leitendenbereich" class="font-semibold text-link">
          Leitendenbereich
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li>
        <a href="/leitendenbereich/mitschriften" class="font-semibold text-link">
          Mitschriften
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Mitschrift</li>
    </ol>
  </nav>

  <h1 class="sr-only">Mitschrift</h1>

  <div class="mt-4">
    <MitschriftAnsicht client:only="svelte" />
    <noscript>
      <p class="border-t border-neutral-200 pt-4 text-sm text-neutral-800">
        Für diese Ansicht wird JavaScript benötigt.
      </p>
    </noscript>
  </div>

  <Footer slot="footer" />
</BaseLayout>
