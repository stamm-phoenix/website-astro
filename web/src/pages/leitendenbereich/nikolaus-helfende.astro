---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import NikolausHelfende from '../../components/NikolausHelfende.svelte';
---

<BaseLayout
  title="Nikolaus-Helfende | Leitendenbereich | Stamm Phoenix"
  description="Helfende des Nikolausdienstes eintragen und auf die Teams verteilen."
>
  <Header slot="header" />

  <nav aria-label="Brotkrümelnavigation" class="mb-4 text-sm print:hidden">
    <ol class="flex flex-wrap items-center gap-1.5 text-neutral-700">
      <li>
        <a href="/leitendenbereich" class="font-semibold text-link">
          Leitendenbereich
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li>
        <a href="/leitendenbereich/nikolaus" class="font-semibold text-link">
          Nikolaus
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Helfende</li>
    </ol>
  </nav>

  <div class="print:hidden">
    <PageHeader
      title="Nikolaus-Helfende"
      description="Wer übernimmt an welchem Tag welchen Posten? Trage die Helfenden ein und lass sie auf die Teams verteilen. Tags verhindern zum Beispiel, dass Leitende ihre eigene Gruppe besuchen."
    />
  </div>

  <div class="mt-8 print:mt-0">
    <NikolausHelfende client:only="svelte" />
    <noscript>
      <p class="surface p-6 text-sm text-neutral-800">
        Für diese Ansicht wird JavaScript benötigt.
      </p>
    </noscript>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style is:global>
  @media print {
    body > header,
    body > footer {
      display: none;
    }
  }
</style>
