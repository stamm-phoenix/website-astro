---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import Abrechnung from '../../components/Abrechnung.svelte';
---

<BaseLayout
  title="Abrechnung | Leitendenbereich | Stamm Phoenix"
  description="Finanzübersicht und KJR-Zuschuss einer Aktion aus CampFlow."
>
  <Header slot="header" />

  <nav aria-label="Brotkrümelnavigation" class="mb-4 text-sm">
    <ol class="flex flex-wrap items-center gap-1.5 text-neutral-700">
      <li>
        <a href="/leitendenbereich" class="font-semibold text-brand-800">
          Leitendenbereich
        </a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">Abrechnung</li>
    </ol>
  </nav>

  <PageHeader
    title="Abrechnung"
    description="Einnahmen und Ausgaben einer Aktion nach Kategorien, die Teilnehmenden und der mögliche Zuschuss vom Kreisjugendring Rosenheim."
  />

  <div class="mt-8">
    <Abrechnung client:only="svelte" />
    <noscript>
      <p class="surface p-6 text-sm text-neutral-800">
        Für diese Ansicht wird JavaScript benötigt.
      </p>
    </noscript>
  </div>

  <Footer slot="footer" />
</BaseLayout>
