---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import BlogList from '../../components/BlogList.svelte';
import InstagramProfileButton from '../../components/InstagramProfileButton.svelte';
---

<BaseLayout
  title="Blog | Stamm Phoenix"
  description="Neuigkeiten, Lagerberichte und Einblicke aus dem DPSG Stamm Phoenix."
>
  <Header slot="header" />

  <PageHeader
    title="Blog"
    description="Neuigkeiten, Lagerberichte und kleine Geschichten aus dem Stammesleben."
  >
    <div class="not-prose mt-4">
      <InstagramProfileButton />
    </div>
  </PageHeader>

  <BlogList client:load />
  <noscript>
    <p class="surface mt-12 p-6 text-neutral-800">
      Um die Beiträge zu sehen, wird JavaScript benötigt.
    </p>
  </noscript>

  <Footer slot="footer" />
</BaseLayout>
