---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogPostLive from '../../components/BlogPostLive.svelte';
---

<!--
  A post shown live from the API (`?id=…`): posts without a static page yet (published after
  the last build, or in PR previews; 404.astro adds `live=1`). Old links lead on to
  /blog/<id>/.
-->
<BaseLayout
  title="Blog | Stamm Phoenix"
  description="Ein Beitrag aus dem Blog des DPSG Stamm Phoenix."
  privatePage
>
  <Header slot="header" />

  <nav aria-label="Brotkrümelnavigation" class="mx-auto mb-6 max-w-3xl text-sm">
    <ol class="flex flex-wrap items-center gap-1.5 text-neutral-700">
      <li>
        <a href="/blog" class="font-semibold text-link">
          Blog
        </a>
      </li>
    </ol>
  </nav>

  <BlogPostLive client:only="svelte" />
  <noscript>
    <p class="mx-auto max-w-3xl text-neutral-700">
      Alle Beiträge findest du in der{' '}
      <a href="/blog" class="font-semibold text-link">
        Blog-Übersicht
      </a>
      .
    </p>
  </noscript>

  <Footer slot="footer" />
</BaseLayout>
