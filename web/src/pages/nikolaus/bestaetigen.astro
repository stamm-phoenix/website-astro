---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import NikolausConfirm from '../../components/NikolausConfirm.svelte';
---

<BaseLayout
  title="Nikolaus-Termin verwalten | Stamm Phoenix"
  description="Bestätigen oder sagen Sie Ihren Termin beim Nikolausdienst des DPSG Stamm Phoenix ab."
>
  <Header slot="header" />

  <PageHeader
    title="Ihr Nikolaus-Termin"
    description="Hier können Sie Ihren Termin bestätigen oder absagen."
  />

  <div class="mt-8">
    <NikolausConfirm client:only="svelte" />
    <noscript>
      <p class="surface p-6 text-sm text-neutral-800">
        Zum Bestätigen des Termins wird JavaScript benötigt.
      </p>
    </noscript>
  </div>

  <Footer slot="footer" />
</BaseLayout>
