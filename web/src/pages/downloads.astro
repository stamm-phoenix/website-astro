---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import DownloadsList from '../components/DownloadsList.svelte';
import { getDownloadsContent } from '../lib/content/content';

// Baked at build time, refreshed in the browser
const downloads = await getDownloadsContent();
---

<BaseLayout
  title="Downloads | Stamm Phoenix"
  description="Dokumente und Dateien zum Herunterladen vom DPSG Stamm Phoenix Feldkirchen-Westerham."
>
  <Header slot="header" />

  <PageHeader title="Downloads" description="Wichtige Dokumente zum Herunterladen." />

  <section class="mt-6" aria-labelledby="downloads-list-heading">
    <h2 id="downloads-list-heading" class="sr-only">
      Verfügbare Downloads
    </h2>
    <DownloadsList client:load initial={downloads.data} images={downloads.images} />
  </section>

  <Footer slot="footer" />
</BaseLayout>
