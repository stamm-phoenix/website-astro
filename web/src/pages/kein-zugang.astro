---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
---

<!--
  Answer of Static Web Apps for a page without the needed role (`responseOverrides.403` in
  staticwebapp.config.json). The roles come from the Microsoft Teams at login (`GetRoles`), so a
  new login picks up a team someone was just added to.
-->
<BaseLayout
  title="Kein Zugang | Stamm Phoenix"
  description="Der Leitendenbereich ist nur für das Team „Leitende“ freigegeben."
  privatePage
>
  <Header slot="header" />

  <PageHeader
    title="Kein Zugang zum Leitendenbereich"
    description="Der Leitendenbereich ist nur für Mitglieder des Teams „Leitende“ in Microsoft Teams freigegeben."
  />

  <div class="mt-8 max-w-2xl space-y-4 text-neutral-800">
    <p>
      Ob du im Team bist, wird bei der Anmeldung geprüft. Bist du gerade erst ins Team gekommen oder
      warst du schon vorher angemeldet, melde dich einmal ab und wieder an.
    </p>
    <p>
      Klappt es danach nicht, schreib an
      <a href="mailto:admin@stamm-phoenix.de">admin@stamm-phoenix.de</a>.
    </p>
  </div>

  <p class="mt-8 flex flex-wrap gap-3">
    <a
      href="/.auth/logout?post_logout_redirect_uri=/login"
      class="btn-primary no-underline"
      data-astro-reload
    >
      Abmelden und neu anmelden
    </a>
    <a href="/" class="btn-secondary no-underline">
      Zur Startseite
    </a>
  </p>

  <Footer slot="footer" />
</BaseLayout>
