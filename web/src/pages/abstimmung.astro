---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import AbstimmungOeffentlich from '../components/abstimmungen/AbstimmungOeffentlich.svelte';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  privatePage
  title="Abstimmung | Stamm Phoenix"
  description="Bei einer Abstimmung oder Terminfindung des Stammes Phoenix mitmachen."
>
  <Header slot="header" />
  <PageHeader title="Abstimmung" />
  <div class="mt-8">
    <AbstimmungOeffentlich client:only="svelte" />
    <noscript>
      <p class="border-t border-neutral-200 pt-4 text-sm text-neutral-800">
        Zum Abstimmen wird JavaScript benötigt.
      </p>
    </noscript>
  </div>
  <Footer slot="footer" />
</BaseLayout>
