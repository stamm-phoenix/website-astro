---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import QuickInfoCard from '../components/QuickInfoCard.astro';
import CTASection from '../components/CTASection.astro';
import Heading from '../components/Heading.astro';
import CardGrid from '../components/CardGrid.astro';
import NikolausBanner from '../components/NikolausBanner.astro';
import NewsFeed from '../components/NewsFeed.svelte';
import { getNewsContent, getNikolausContent } from '../lib/content/content';

const hero = {
  title: 'Gemeinschaft. Abenteuer. Verantwortung.',
  subtitle: 'Willkommen beim DPSG Stamm Phoenix Feldkirchen-Westerham',
  description:
    'Wir sind draußen unterwegs, entdecken die Natur und lösen Aufgaben im Team. Kinder und Jugendliche lernen dabei, was sie können, und übernehmen Verantwortung füreinander.',
  primaryButtonText: 'Jetzt mitmachen',
  primaryButtonLink: '/mitmachen',
  secondaryButtonText: 'Gruppenstunden',
  secondaryButtonLink: '/gruppenstunden',
};

const quickInfo = [
  {
    title: 'Für alle Altersstufen',
    description:
      'Wölflinge, Jungpfadfinder, Pfadfinder und Rover haben jeweils eigene Gruppenstunden, abgestimmt auf ihr Alter.',
  },
  {
    title: 'Draußen erleben',
    description:
      'Auf Zeltlagern, Hikes und in Projekten lernen Kinder, selbst anzupacken, im Team zu arbeiten und Neues auszuprobieren.',
  },
  {
    title: 'Werte leben',
    description:
      'Respekt, Verantwortung und Mitbestimmung prägen, wie wir miteinander umgehen: in der Gruppenstunde genauso wie im Zeltlager.',
  },
];

const callToAction = {
  title: 'Mach mit!',
  description:
    'Du willst zu den Pfadfindern? Komm zu einer kostenlosen Schnupperstunde und lern uns kennen.',
  buttonText: 'Jetzt mitmachen',
  buttonLink: '/mitmachen',
};

// Baked at build time, refreshed in the browser
const news = await getNewsContent();
const nikolaus = await getNikolausContent();
---

<BaseLayout
  title="Willkommen | Stamm Phoenix"
  description="DPSG Stamm Phoenix aus Feldkirchen-Westerham: Gruppenstunden für Kinder und Jugendliche von 7 bis 18 Jahren, Zeltlager und Aktionen."
>
  <Header slot="header" />

  {nikolaus.publicActive && <NikolausBanner config={nikolaus} />}

  <HeroSection
    title={hero.title}
    subtitle={hero.subtitle}
    description={hero.description}
    primaryButtonText={hero.primaryButtonText}
    primaryButtonLink={hero.primaryButtonLink}
    secondaryButtonText={hero.secondaryButtonText}
    secondaryButtonLink={hero.secondaryButtonLink}
  />

  <section class="mt-12 space-y-4" aria-labelledby="quick-info-heading">
    <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
      <Heading level={2} id="quick-info-heading" variant="section">
        Was uns ausmacht
      </Heading>
    </div>
    <CardGrid cols={3}>
      {quickInfo.map((info) => (
        <QuickInfoCard title={info.title} description={info.description} />
      ))}
    </CardGrid>
  </section>

  <NewsFeed
    client:visible
    initialBlog={news.blog}
    initialInstagram={news.instagram}
    images={news.images}
  />

  <CTASection
    title={callToAction.title}
    description={callToAction.description}
    buttonText={callToAction.buttonText}
    buttonLink={callToAction.buttonLink}
  />

  <Footer slot="footer" />
</BaseLayout>
