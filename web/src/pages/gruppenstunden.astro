---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import Card from '../components/Card.astro';
import Heading from '../components/Heading.astro';
import Text from '../components/Text.astro';
import TextLink from '../components/TextLink.astro';
import Button from '../components/Button.astro';
import SchulferienHinweis from '../components/SchulferienHinweis.svelte';
import { requireCurrentSchulferien } from '../lib/schulferien';
import GruppenstundenList from '../components/GruppenstundenList.svelte';
import { getGruppenstundenContent } from '../lib/content/content';

// Baked at build time, refreshed in the browser
requireCurrentSchulferien();
const gruppenstunden = await getGruppenstundenContent();
---

<BaseLayout title="Gruppenstunden | Stamm Phoenix">
  <Header slot="header" />

  <PageHeader
    title="Gruppenstunden"
    description="Unsere wöchentlichen Gruppenstunden im Überblick."
  />

  <SchulferienHinweis client:only="svelte" />

  <div class="mt-6">
    <GruppenstundenList client:load initial={gruppenstunden.data} images={gruppenstunden.images} />
  </div>

  <Card class="mt-8 border-l-4 border-l-accent-500">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <Heading level={2} variant="card">
          Interesse an einer Schnupperstunde?
        </Heading>
        <Text class="mt-1">Sag uns Alter und Wunschzeit, dann schicken wir dir einen Termin.</Text>
      </div>
      <Button href="/mitmachen#schnupperstunde" variant="cta">
        Schnupperstunde anfragen
      </Button>
    </div>
  </Card>

  <section class="mt-12" aria-labelledby="leitendenrunde-heading">
    <Heading level={2} id="leitendenrunde-heading">
      Leitendenrunde
    </Heading>
    <div class="max-w-3xl">
      <Text>
        Neben den Gruppenstunden treffen sich unsere <strong>Gruppenleiter</strong> regelmäßig in
        der Leitendenrunde. Dort planen wir Aktionen, tauschen uns aus und entwickeln das Programm
        weiter.
      </Text>
      <Text class="mt-3">
        <strong>Zu alt für die Rover?</strong> Dann bleib als Gruppenleiter dabei und gib deine
        Erfahrung weiter. Mehr dazu auf der <TextLink href="/mitmachen">Mitmachen-Seite</TextLink>.
      </Text>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
