---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Heading from '../components/Heading.astro';
import NikolausFAQ from '../components/NikolausFAQ.astro';
import NikolausBooking from '../components/NikolausBooking.svelte';
import NikolausLinkRequest from '../components/NikolausLinkRequest.svelte';
import phoenixlaus from '../assets/phoenixlaus.png';
import { formatNikolausDays } from '../lib/nikolausConfig';
import { getNikolausContent } from '../lib/content/content';

// Baked at build time; the Steuerung starts a build when the settings change
const config = await getNikolausContent();
const active = config.publicActive && config.days.length > 0;
const dayList = formatNikolausDays(config, { withYear: true });
---

<BaseLayout
  title="Nikolausdienst | Stamm Phoenix"
  description={
    active
      ? `Der Nikolaus des DPSG Stamm Phoenix kommt am ${formatNikolausDays(config)} zu Ihnen nach Hause. Buchen Sie jetzt online einen Termin.`
      : 'Jedes Jahr rund um den Nikolaustag besucht der Nikolaus des DPSG Stamm Phoenix Familien zu Hause.'
  }
>
  <Header slot="header" />

  <section
    class="border-b border-[var(--color-neutral-200)] pb-8 md:pb-10"
    aria-labelledby="nikolaus-title"
  >
    <div class="grid items-center gap-6 md:grid-cols-[auto_1fr] md:gap-10">
      <Image
        src={phoenixlaus}
        alt=""
        aria-hidden="true"
        width={180}
        class="mx-auto h-auto w-32 md:w-44"
        loading="eager"
      />
      <div>
        <p class="badge text-danger">Nikolausdienst</p>
        <h1
          id="nikolaus-title"
          class="mt-2 font-serif text-3xl md:text-4xl font-bold text-brand-900 leading-tight"
        >
          Der Nikolaus kommt zu Ihnen nach Hause!
        </h1>
        <p class="mt-4 max-w-2xl text-neutral-800 leading-relaxed">
          {active ? (
            <>
              Am <strong>{dayList}</strong> besuchen Nikolaus, Krampus und Engerl des DPSG Stamm
              Phoenix Familien in Feldkirchen-Westerham, Bruckmühl und Umgebung. Buchen Sie unten
              online einen Termin für einen Besuch von bis zu 30 Minuten.
            </>
          ) : (
            <>
              Jedes Jahr rund um den Nikolaustag besuchen Nikolaus, Krampus und Engerl des DPSG
              Stamm Phoenix Familien in Feldkirchen-Westerham, Bruckmühl und Umgebung.
            </>
          )}
        </p>
        {active && (
          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
            <a href="#nikolaus-anmeldung" class="btn-primary no-underline">
              Zur Terminbuchung
            </a>
            <a
              href="#termin-verwalten"
              class="text-sm font-semibold text-link underline underline-offset-2 hover:text-brand-900"
            >
              Schon gebucht? Zur Terminverwaltung
            </a>
          </div>
        )}
      </div>
    </div>
  </section>

  {!active && (
    <section
      class="mt-8 surface p-6 border-l-4! border-l-accent-500!"
      aria-labelledby="nikolaus-closed-heading"
    >
      <h2 id="nikolaus-closed-heading" class="text-lg font-semibold text-brand-900">
        Die Anmeldung ist derzeit geschlossen
      </h2>
      <p class="mt-1 text-sm text-neutral-800">
        Die Buchung für den nächsten Nikolausdienst schalten wir rechtzeitig vor Dezember hier frei.
      </p>
    </section>
  )}

  <div class="mt-12">
    <NikolausFAQ config={config} />
  </div>

  {active && (
    <section
      id="nikolaus-anmeldung"
      class="mt-12 scroll-mt-28"
      aria-labelledby="nikolaus-anmeldung-heading"
    >
      <Heading level={2} id="nikolaus-anmeldung-heading" variant="section">
        Termin buchen
      </Heading>
      <NikolausBooking config={config} client:only="svelte" />
      <noscript>
        <p class="surface p-6 text-sm text-neutral-800">
          Die Terminbuchung funktioniert nur mit JavaScript. Sie erreichen uns auch unter
          <a href="mailto:kontakt@stamm-phoenix.de">kontakt@stamm-phoenix.de</a>.
        </p>
      </noscript>
    </section>
  )}

  {active && (
    <section
      id="termin-verwalten"
      class="mt-12 scroll-mt-28"
      aria-labelledby="termin-verwalten-heading"
    >
      <Heading level={2} id="termin-verwalten-heading" variant="section">
        Schon gebucht?
      </Heading>
      <div class="surface p-5 md:p-6">
        <p class="text-neutral-800 leading-relaxed">
          Der Link in Ihrer Bestätigungs-E-Mail führt zur Terminverwaltung. E-Mail nicht mehr
          auffindbar? Wir schicken Ihnen einen neuen Link.
        </p>
        <div class="mt-4">
          <NikolausLinkRequest idPrefix="nikolaus-lost" client:only="svelte" />
        </div>
      </div>
    </section>
  )}

  <Footer slot="footer" />
</BaseLayout>
