{
  "name": "stamm-phoenix-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --cache --cache-strategy content",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:mock": "MOCK_API=1 astro dev",
    "check:astro": "astro check",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "check": "astro sync && bun run --parallel --no-exit-on-error lint check:astro check:svelte test:unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:unit": "bun test test/"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/svelte": "9.1.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-blockquote": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-code": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-hard-break": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-horizontal-rule": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-strike": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "altcha": "3.5.0",
    "astro": "7.4.2",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "leaflet": "1.9.4",
    "linkedom": "0.18.14",
    "marked": "18.1.1",
    "pdfjs-dist": "6.4.299",
    "qrcode-generator": "2.0.4",
    "svelte": "5.57.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource/arvo": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "astro-eslint-parser": "3.2.0",
    "baseline-browser-mapping": "2.11.32",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-svelte": "4.1.1",
    "serve": "14.2.6",
    "svelte-check": "4.7.7",
    "svgo": "4.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "sharp"
