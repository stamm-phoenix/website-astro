{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "azure": {
      "type": "local",
      "command": [
        "nix",
        "run",
        "--quiet",
        "--no-write-lock-file",
        ".#azure-mcp",
        "--",
        "server",
        "start"
      ],
      "enabled": true,
      "timeout": 120000
    }
  }
}
