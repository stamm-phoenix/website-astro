{
  "name": "api",
  "version": "1.0.0",
  "description": "Azure Static Web Apps API",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prestart": "pnpm run build",
    "start": "swa start --api-location .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@azure/functions": "4.11.0",
    "@azure/identity": "4.13.0",
    "@microsoft/microsoft-graph-client": "3.0.7"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "2.0.8",
    "@eslint/js": "10.0.1",
    "@types/node": "25.2.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
