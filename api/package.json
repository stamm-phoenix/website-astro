{
  "name": "api",
  "version": "1.0.0",
  "description": "Azure Static Web Apps API",
  "main": "dist/bundle/main.js",
  "scripts": {
    "build": "tsc && node scripts/bundle.mjs",
    "test": "bun run build && node --test dist/test/*.test.js",
    "watch": "node scripts/bundle.mjs --watch",
    "prestart": "bun run build",
    "start": "node ../scripts/dev-full.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@azure/functions": "4.17.0",
    "@azure/identity": "4.13.0",
    "@azure/storage-blob": "12.34.0",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "altcha-lib": "2.8.0",
    "kysely": "0.28.19",
    "marked": "18.1.3",
    "pdfjs-dist": "6.5.438",
    "pdfmake": "0.3.13",
    "sharp": "0.35.5",
    "tarn": "3.1.2",
    "tedious": "20.3.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "2.1.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/pdfmake": "0.3.3",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
